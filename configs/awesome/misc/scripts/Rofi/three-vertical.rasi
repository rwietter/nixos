/*

-- ROFI MUSIC POPUP THEME!
-- edited from: adi1090x/rofi

 */


configuration {
	disable-history: false;
	fullscreen: false;
	hide-scrollbar: true;
	sidebar-mode: false;
}

* {
	accent: #1e88e5;
	background: #101012;
	foreground-neutral:#6b6b6b;
	foreground: #eceff1;
	on: #66bb6a;
	off: #ef5350;
}

* {
	background-color: @background;
	text-color: @foreground;
}

window {
	transparency: "real";
	border-radius: 8px;
	width: 78px;
	location: east;
	x-offset: -15px;
	padding: 5px;
	y-offset: 0px;
}

listview {
	lines: 3;
	margin: 0px;
	spacing: 5px;
	cycle: true;
	dynamic: true;
	layout: vertical;
}

mainbox {
	background-color: @background;
	children: [ listview];
}

element {
	background-color: transparent;
	orientation: vertical;
	spacing: 5px;
	border-radius: 4px;
}

element-text {
	font: "FontAwesome 17";
	expand: true;
	text-color: @foreground-neutral;
	horizontal-align: 0.4;
	vertical-align: 0;
	margin: 20px 10px;
}

element normal.urgent,
element alternate.urgent {
	background-color: @off;
	text-color: @background;
	border-radius: 10px;
}

element normal.active,
element alternate.active {
	background-color: @on;
	text-color: @background;
}

element selected {
	background-color: transparent;
	text-color: @foreground;
	border: 0px;
	border-color: transparent;
}

element-text selected {
	font: "FontAwesome 17";
	text-color: @foreground;
	horizontal-align: 0.4;
	vertical-align: 0;
	margin: 20px 10px;
}

element selected.urgent {
	background-color: @on;
	text-color: @background;
}

element selected.active {
	background-color: @off;
	color: @background;
}
